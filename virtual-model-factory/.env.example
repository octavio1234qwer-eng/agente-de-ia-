# =============================================================================
# Virtual Model Factory AI — variables de entorno (copia a .env.local)
# Genera secretos aleatorios con: npm run secrets:generate
# NUNCA subas .env.local al repositorio ni uses prefijo NEXT_PUBLIC_ para secretos.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Vacío => PostgreSQL embebido (PGlite) en PGLITE_DATA_DIR, solo para desarrollo.
# Supabase: Project Settings → Database → Connection string (Session pooler).
DATABASE_URL=
# disable | require | verify-full (por defecto verify-full fuera de localhost)
DATABASE_SSL_MODE=
# Certificado CA de Supabase (PEM o base64) para verify-full
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
# true => aplica migraciones al arrancar con DATABASE_URL (recomendado: npm run db:migrate)
DB_AUTO_MIGRATE=false
PGLITE_DATA_DIR=.data/pglite
ALLOW_EMBEDDED_DB_IN_PRODUCTION=false

# --- Sesiones y seguridad ----------------------------------------------------
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12
# 32 bytes en base64 (cifrado AES-256-GCM de tokens de integraciones)
ENCRYPTION_KEY=
# Habilita /setup para crear el primer propietario (24+ caracteres). Bórralo después.
SETUP_TOKEN=
# true solo detrás de un proxy de confianza (Vercel, Nginx) para leer la IP real
TRUST_PROXY_HEADERS=false
# auto => Secure en producción
SECURE_COOKIES=auto

# --- Integraciones (fases siguientes) ----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=
CRON_SECRET=
