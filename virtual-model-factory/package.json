{
  "name": "virtual-model-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.mts",
    "db:seed:demo": "node --conditions=react-server --import tsx scripts/seed-demo.mts",
    "admin:create": "node --conditions=react-server --import tsx scripts/create-admin.mts",
    "secrets:generate": "node scripts/generate-secrets.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20.9 <25"
  }
}
