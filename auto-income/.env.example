# AUTO-INCOME AI — copia a .env (o configura como secretos en tu proveedor). Nunca subas .env.
NODE_ENV=production
PORT=8787
# Ruta del archivo SQLite. En hosting usa un disco persistente.
DATABASE_PATH=./data/auto-income.db
# Secreto aleatorio largo (>= 32 caracteres). Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Solo para crear la cuenta del propietario por primera vez (>= 16 caracteres). BÓRRALO después.
OWNER_SETUP_TOKEN=
# Si el servidor está detrás de un proxy (Render, Railway, etc.) pon 1 para leer la IP real.
TRUST_PROXY=0
# Nivel de autonomía para tareas sin negocio (0-4). Inicial: 2.
DEFAULT_AUTONOMY_LEVEL=2
# Worker del orquestador (0 = desactivado) y frecuencia.
WORKER_ENABLED=1
WORKER_INTERVAL_MS=10000
# Opcional: secreto HMAC (>= 32 caracteres) para webhooks de pago firmados. Sin él solo existe el modo DEMO.
PAYMENT_WEBHOOK_SECRET=
