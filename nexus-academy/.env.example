# =============================================================================
# NEXUS ACADEMY · Variables de entorno
# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local
# al repositorio. Las variables sin el prefijo NEXT_PUBLIC_ solo existen en el
# servidor y jamás llegan al navegador.
# =============================================================================

# --- Sitio ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="NEXUS ACADEMY"
# Nombre del tutor con IA y lema (opcionales). Los colores están en src/app/globals.css (@theme).
NEXT_PUBLIC_AI_NAME="NEXUS AI"
NEXT_PUBLIC_SITE_TAGLINE="Aprende hoy. Domina el mañana."

# --- Supabase (obligatorio) -----------------------------------------------------
# Local: valores que imprime `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO servidor. Permite confirmar pagos y enviar correos.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (tarjetas) ------------------------------------------------------------
# Dashboard → Developers → API keys. Usa sk_test_… para pruebas.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → endpoint /api/webhooks/stripe → Signing secret
STRIPE_WEBHOOK_SECRET=

# --- Mercado Pago (México) --------------------------------------------------------
# Tus integraciones → Credenciales de producción/prueba → Access Token
MERCADOPAGO_ACCESS_TOKEN=
# Tus integraciones → Webhooks → Clave secreta (para validar x-signature)
MERCADOPAGO_WEBHOOK_SECRET=

# --- PayPal -------------------------------------------------------------------------
# developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del webhook creado para /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=
# sandbox | live
PAYPAL_ENV=sandbox

# --- Correo (Resend) ----------------------------------------------------------------
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej. "NEXUS ACADEMY <hola@tudominio.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- NEXUS AI (Claude) --------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Mensajes por alumno cada 24 h
AI_DAILY_MESSAGE_LIMIT=60

# --- Seguridad / automatizaciones -----------------------------------------------------
# Cadena aleatoria larga (openssl rand -hex 32). Protege /api/cron/*.
CRON_SECRET=
# Cadena aleatoria larga para firmar enlaces de baja de correos.
UNSUBSCRIBE_SECRET=
