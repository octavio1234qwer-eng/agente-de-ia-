{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/abandoned-carts",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/expire-orders",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/streak-reminders?zona=america",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/streak-reminders?zona=europa",
      "schedule": "0 18 * * *"
    }
  ]
}
