    {
     "header": "Costo de compra",
     "width": 11,
     "format": "money"
    },
    {
     "header": "Precio de venta",
     "width": 11,
     "format": "money"
    },
    {
     "header": "Margen",
     "width": 9,
     "format": "pct",
     "formula": "=IF(OR(F{r}=\"\",G{r}=\"\"),\"\",IFERROR((G{r}-F{r})/G{r},\"\"))"
    },
    {
     "header": "Existencia inicial",
     "width": 10,
     "format": "num"
    },
    {
     "header": "Compras",
     "width": 9,
     "format": "num",
     "formula": "=IF(B{r}=\"\",\"\",SUMIFS(Movimientos!$D$4:$D$2003,Movimientos!$B$4:$B$2003,B{r},Movimientos!$C$4:$C$2003,\"Compra\"))"
    },
    {
     "header": "Ventas",
     "width": 9,
     "format": "num",
     "formula": "=IF(B{r}=\"\",\"\",SUMIFS(Movimientos!$D$4:$D$2003,Movimientos!$B$4:$B$2003,B{r},Movimientos!$C$4:$C$2003,\"Venta\"))"
    },
    {
     "header": "Mermas",
     "width": 9,
     "format": "num",
     "formula": "=IF(B{r}=\"\",\"\",SUMIFS(Movimientos!$D$4:$D$2003,Movimientos!$B$4:$B$2003,B{r},Movimientos!$C$4:$C$2003,\"Merma\"))"
    },
    {
     "header": "Ajustes",
     "width": 9,
     "format": "num",
     "formula": "=IF(B{r}=\"\",\"\",SUMIFS(Movimientos!$D$4:$D$2003,Movimientos!$B$4:$B$2003,B{r},Movimientos!$C$4:$C$2003,\"Ajuste +\")-SUMIFS(Movimientos!$D$4:$D$2003,Movimientos!$B$4:$B$2003,B{r},Movimientos!$C$4:$C$2003,\"Ajuste -\"))"
    },
    {
     "header": "Existencia actual",
     "width": 11,
     "format": "num",
     "formula": "=IF(B{r}=\"\",\"\",N(I{r})+J{r}-K{r}-L{r}+M{r})"
    },
    {
     "header": "Stock mínimo",
     "width": 9,
     "format": "num"
    },
    {
     "header": "Estado",
     "width": 10,
     "formula": "=IF(B{r}=\"\",\"\",IF(N{r}<=0,\"Agotado\",IF(N{r}<=N(O{r}),\"Pedir\",\"OK\")))"
    },
    {
     "header": "Pedido sugerido",
     "width": 10,
     "format": "num",
     "formula": "=IF(OR(B{r}=\"\",O{r}=\"\"),\"\",MAX(0,O{r}*2-N{r}))"
    },
    {
     "header": "Valor a costo",
     "width": 11,
     "format": "money",
     "formula": "=IF(OR(B{r}=\"\",F{r}=\"\"),\"\",MAX(0,N{r})*F{r})"
    },
    {
     "header": "Venta del periodo",
     "width": 12,
     "format": "money",
     "formula": "=IF(OR(B{r}=\"\",G{r}=\"\"),\"\",K{r}*G{r})"
    },
    {
     "header": "Utilidad bruta",
     "width": 11,
     "format": "money",
     "formula": "=IF(OR(B{r}=\"\",F{r}=\"\",G{r}=\"\"),\"\",K{r}*(G{r}-F{r}))"
    },
    {
     "header": "Merma a costo",
     "width": 11,
     "format": "money",
     "formula": "=IF(OR(B{r}=\"\",F{r}=\"\"),\"\",L{r}*F{r})"
    }
