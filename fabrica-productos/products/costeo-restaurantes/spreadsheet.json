    {
     "header": "Costo de la receta",
     "width": 12,
     "format": "money",
     "formula": "=IF(A{r}=\"\",\"\",SUMIF(Recetas!$A$4:$A$503,A{r},Recetas!$F$4:$F$503))"
    },
    {
     "header": "Costo extra por porción",
     "width": 11,
     "format": "money"
    },
    {
     "header": "Costo por porción",
     "width": 12,
     "format": "money",
     "formula": "=IF(A{r}=\"\",\"\",IFERROR(D{r}/C{r}+E{r},\"\"))"
    },
    {
     "header": "Precio en menú",
     "width": 11,
     "format": "money"
    },
    {
     "header": "Precio sin IVA",
     "width": 11,
     "format": "money",
     "formula": "=IF(G{r}=\"\",\"\",IF('Configuración'!$B$6=\"Sí\",G{r}/(1+'Configuración'!$B$5),G{r}))"
    },
    {
     "header": "Food cost %",
     "width": 10,
     "format": "pct",
     "formula": "=IF(OR(F{r}=\"\",H{r}=\"\"),\"\",IFERROR(F{r}/H{r},\"\"))"
    },
    {
     "header": "Margen por porción",
     "width": 11,
     "format": "money",
     "formula": "=IF(OR(F{r}=\"\",H{r}=\"\"),\"\",H{r}-F{r})"
    },
    {
     "header": "Precio sugerido en menú",
     "width": 12,
     "format": "money",
     "formula": "=IF(F{r}=\"\",\"\",CEILING(F{r}/'Configuración'!$B$4*IF('Configuración'!$B$6=\"Sí\",1+'Configuración'!$B$5,1),5))"
    },
    {
     "header": "Vendidos en el mes",
     "width": 10,
     "format": "int"
    },
    {
     "header": "Popularidad",
     "width": 11,
     "formula": "=IF(OR(A{r}=\"\",L{r}=\"\"),\"\",IF(L{r}>='Configuración'!$B$11,\"Alta\",\"Baja\"))"
    },
    {
     "header": "Margen total del mes",
     "width": 13,
     "format": "money",
     "formula": "=IF(OR(J{r}=\"\",L{r}=\"\"),\"\",J{r}*L{r})"
    },
    {
     "header": "Rentabilidad",
     "width": 11,
     "formula": "=IF(OR(A{r}=\"\",J{r}=\"\",L{r}=\"\"),\"\",IF(J{r}>='Configuración'!$B$12,\"Alta\",\"Baja\"))"
    },
    {
     "header": "Clasificación",
     "width": 17,
     "formula": "=IF(OR(M{r}=\"\",O{r}=\"\"),\"\",IF(AND(M{r}=\"Alta\",O{r}=\"Alta\"),\"Estrella\",IF(M{r}=\"Alta\",\"Caballo de batalla\",IF(O{r}=\"Alta\",\"Rompecabezas\",\"Perro\"))))"
    },
    {
     "header": "Qué hacer",
     "width": 38,
     "formula": "=IF(P{r}=\"\",\"\",IF(P{r}=\"Estrella\",\"Mantener porción, calidad y lugar destacado\",IF(P{r}=\"Caballo de batalla\",\"Subir precio en pasos pequeños o ajustar receta\",IF(P{r}=\"Rompecabezas\",\"Darle mejor lugar en el menú y recomendarlo\",\"Rediseñar o sacar del menú\"))))"
    },
