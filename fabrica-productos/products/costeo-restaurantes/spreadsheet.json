  {
   "name": "Platillos",
   "title": "Platillos: costo, precio y ingeniería de menú",
   "rows": 150,
   "freeze": "B4",
   "note": "Captura porciones, precio y ventas del mes. Rojo = food cost arriba del objetivo.",
   "columns": [
    {
     "header": "Platillo",
     "width": 30
