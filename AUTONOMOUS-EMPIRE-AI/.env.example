# ── Base de datos ─────────────────────────────────────────────
# Producción: cadena de conexión de Supabase (Project Settings → Database → Connection string, modo "Session pooler").
# Sin DATABASE_URL se usa PGlite (Postgres embebido) en .data/pglite — solo para desarrollo local.
DATABASE_URL=

# ── Sesiones y cron ───────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CRON_SECRET=
# Sal para anonimizar IP/UA en clics y visitas (hash). Otra cadena aleatoria.
ANALYTICS_SALT=

# ── Mercado Pago (cobros) — opcional hasta autorizar ─────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# ── Gumroad (productos digitales, solo lectura de ventas) ────
GUMROAD_ACCESS_TOKEN=

# ── Correo (SMTP) — opcional; sin él, los correos quedan como borradores ──
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
EMAIL_DAILY_CAP=20

# ── IA (opcional): borradores de contenido con Claude API ────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Google Analytics 4 (opcional, solo sitio público) ────────
NEXT_PUBLIC_GA_ID=
