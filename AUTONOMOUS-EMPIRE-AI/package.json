{
  "name": "autonomous-empire-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/command-center"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:bundle": "tsx scripts/bundle-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "routine": "tsx automation/run.ts",
    "audit:verify": "tsx scripts/verify-audit.ts",
    "dev": "npm run dev -w apps/command-center",
    "build": "npm run db:bundle && npm run build -w apps/command-center"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
