{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": { "@empire/*": ["./*"] }
  },
  "include": ["core", "agents", "businesses", "automation", "infrastructure", "finance", "scripts", "tests"],
  "exclude": ["node_modules", "apps"]
}
