# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# En producción define estas variables en el panel de tu proveedor (Render, Railway, VPS…).

# --- Aplicación ---
NODE_ENV=development
PORT=3000
APP_NAME=ImpulsaIA
# URL pública exacta (sin / final). En producción debe ser https://
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Mexico_City
# Pon 1 si la app corre detrás de un proxy o balanceador (Render, Railway, Nginx, Caddy).
TRUST_PROXY=0
LOG_LEVEL=info
# Correo que se muestra a clientes para soporte y facturación (CFDI).
SUPPORT_EMAIL=

# --- Base de datos ---
# Producción: PostgreSQL. Ejemplo: postgres://usuario:contraseña@host:5432/impulsaia
# Desarrollo: déjala vacía y se usa una base embebida en ./data/pglite
DATABASE_URL=
# disable | require | no-verify  (usa require si tu proveedor exige SSL con certificado válido)
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# --- Cuentas ---
SESSION_TTL_DAYS=30
# Exigir confirmar el correo antes de usar la IA (recomendado: evita abuso del plan gratuito).
REQUIRE_EMAIL_VERIFICATION=true
# Correos que se convierten en administradores al confirmar su correo (separados por comas).
ADMIN_EMAILS=

# --- Inteligencia artificial ---
# openai | anthropic | mock (mock = textos de demostración sin costo, para desarrollo)
AI_PROVIDER=mock
# Modelo habilitado en tu cuenta del proveedor (revisa su consola). Obligatorio salvo con mock.
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=60000
# Precio por millón de tokens en USD de tu modelo (de la página de precios del proveedor).
# Solo se usan para estimar el costo de IA en el panel de administración.
AI_COST_INPUT_USD_PER_MTOK=0
AI_COST_OUTPUT_USD_PER_MTOK=0

# --- Pagos con Stripe (México, MXN) ---
# Usa claves de prueba (sk_test_...) hasta que todo funcione.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: IDs de precio. Si los dejas vacíos se buscan por lookup_key (npm run stripe:setup los crea).
STRIPE_PRICE_PRO=
STRIPE_PRICE_NEGOCIO=

# --- Planes (créditos al mes y precio mostrado en MXN con IVA) ---
# El precio que se cobra lo define Stripe: si cambias estos montos, vuelve a ejecutar npm run stripe:setup.
PLAN_FREE_CREDITS=25
PLAN_PRO_CREDITS=500
PLAN_NEGOCIO_CREDITS=2000
PLAN_PRO_PRICE_MXN=199
PLAN_NEGOCIO_PRICE_MXN=499

# --- Correo (SMTP) para confirmación de cuenta y recuperación de contraseña ---
# Sin SMTP en desarrollo, los enlaces se imprimen en la consola.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=ImpulsaIA <no-reply@tudominio.mx>
